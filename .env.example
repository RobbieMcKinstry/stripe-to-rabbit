# Server Configuration
NODE_ENV=development
PORT=3000

# Stripe Configuration
# Get your secret key from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Get your webhook secret from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: Specify Stripe API version (defaults to latest)
# STRIPE_API_VERSION=2025-01-27.acacia

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# RabbitMQ Exchange and Queue Configuration
RABBITMQ_EXCHANGE=stripe.events
RABBITMQ_EXCHANGE_TYPE=topic
RABBITMQ_QUEUE=stripe.webhooks
RABBITMQ_ROUTING_KEY=stripe.webhook

# RabbitMQ Connection Settings
RABBITMQ_USE_SSL=false
RABBITMQ_CONNECTION_TIMEOUT=10000
RABBITMQ_HEARTBEAT=60
